{
  "name": "frontend-next",
  "version": "0.1.0",
  "description": "Bisan SQL Client Application",
  "author": "devch",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron-tsc": "tsc -p tsconfig.electron.json",
    "electron-dev": "npm run electron-tsc && concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "next build && npm run electron-tsc && electron-builder"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.102.8",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "axios": "^1.20.0",
    "idb": "^8.0.3",
    "monaco-editor": "^0.52.2",
    "next": "16.3.3",
    "node-sql-parser": "^5.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-sql-parser": "^1.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.bisan.sql.frontend",
    "productName": "BisanSQLClient",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "files": [
      "out/**/*",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    }
  }
}
